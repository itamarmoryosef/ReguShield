# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — used by the GPT-4o Vision scanner
OPENAI_API_KEY=sk-...

# Background jobs (QStash / Trigger.dev)
# Daily cron → POST /api/jobs/reminders/enqueue
# Per-job worker → POST /api/jobs/reminders/process
# Retry worker → POST /api/jobs/retries
JOBS_WEBHOOK_SECRET=replace-with-long-random-secret
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_TOKEN=
JOBS_PROCESS_URL=https://your-domain.com/api/jobs/reminders/process

# Optional: force local demo dashboards without live Supabase
# NEXT_PUBLIC_DEMO_MODE=true
# JOBS_ALLOW_INSECURE_DEV=true
